# Caminho: servicos/.env.example
# Modelo das variáveis dos serviços sintéticos (Gateway, Ledger, Pix, Antifraude).
# Gere o servicos/.env com:  python3 scripts/gerar_env.py
# O servicos/.env NUNCA deve ser versionado.

# Chave de assinatura dos tokens de cliente emitidos pelo Gateway.
TOKEN_SECRET=defina-pelo-gerar_env

# Segredo compartilhado nas chamadas serviço-a-serviço (Ledger/Pix -> Antifraude).
SERVICO_TOKEN=defina-pelo-gerar_env

# Senha comum dos usuários sintéticos cliente01..cliente20.
SENHA_USUARIOS_SINTETICOS=defina-pelo-gerar_env

# Chave HMAC para pseudonimizar chaves Pix e contas nos logs.
LOG_PSEUDONIMO_CHAVE=defina-pelo-gerar_env

# 1 = confia em X-Forwarded-For (necessário para o simulador variar IPs).
# Em produção, só com um proxy reverso confiável à frente.
CONFIAR_PROXY=1

# UID/GID com que os contêineres rodam, para gravar em ../logs com o mesmo
# dono do seu usuário no host (preenchidos automaticamente pelo gerar_env).
UID_HOST=auto-uid
GID_HOST=auto-gid

# Portas publicadas em 127.0.0.1.
GATEWAY_PORT=8080
LEDGER_PORT=8081
PIX_PORT=8082
ANTIFRAUDE_PORT=8083
