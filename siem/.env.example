# Caminho: siem/.env.example
# Modelo das variáveis de ambiente do SIEM local.
# NÃO preencha este arquivo com segredos reais: gere o siem/.env com
#   python3 siem/scripts/gerar_env.py
# O arquivo siem/.env está no .gitignore e jamais deve ser versionado.

# Versão da stack Elastic (Elasticsearch, Kibana e Filebeat usam a mesma).
ELASTIC_VERSION=8.17.4

# Nome lógico do cluster.
CLUSTER_NAME=siem-bancario-lab

# Senha do superusuário "elastic" (uso administrativo e login no Kibana).
ELASTIC_PASSWORD=defina-pelo-gerar_env

# Senha do usuário interno "kibana_system" (Kibana -> Elasticsearch).
KIBANA_PASSWORD=defina-pelo-gerar_env

# Chaves de criptografia do Kibana (mínimo de 32 caracteres cada).
# A de saved objects é obrigatória para regras de alerta.
KIBANA_ENCRYPTEDSAVEDOBJECTS_KEY=defina-pelo-gerar_env
KIBANA_SECURITY_KEY=defina-pelo-gerar_env
KIBANA_REPORTING_KEY=defina-pelo-gerar_env

# Usuários de menor privilégio criados pelo setup (Etapa 4):
# filebeat_writer só grava eventos; siem_correlacao lê eventos e grava alertas.
FILEBEAT_PASSWORD=defina-pelo-gerar_env
CORRELACAO_PASSWORD=defina-pelo-gerar_env

# Limites de memória dos contêineres (em bytes).
ES_MEM_LIMIT=2147483648
KB_MEM_LIMIT=1073741824

# Portas publicadas SOMENTE em 127.0.0.1 (nunca expostas na rede).
ES_PORT=9200
KIBANA_PORT=5601
